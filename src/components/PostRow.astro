---
// One row in a post list (Series page, tag page): [number?] [4:3 cover thumb?] [text slot].
// The number stays in its own leftmost column so ordered lists read like a playlist.
// Posts without a cover keep the text-only row.
import type { CollectionEntry } from 'astro:content';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  post: CollectionEntry<'blog'>;
  href: string;
  number?: string;
}

const { post, href, number, class: className, ...attrs } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<a href={href} class:list={['group flex items-start gap-3 no-underline sm:gap-4', className]} {...attrs}>
  {number && <span class="w-6 shrink-0 pt-0.5 text-sm tabular-nums text-muted">{number}</span>}
  {post.data.cover && (
    <img
      class="aspect-[4/3] w-24 shrink-0 rounded-md border border-border bg-surface object-cover sm:w-40"
      src={`${base}images/posts/${post.id}/thumb.jpg`}
      alt=""
      width="480"
      height="360"
      loading="lazy"
      decoding="async"
    />
  )}
  <div class="min-w-0 flex-1">
    <slot />
  </div>
</a>
