---
import { Search } from '@lucide/astro';
import SearchBox from './SearchBox.astro';

interface Props {
  buttonClass: string;
}

const { buttonClass } = Astro.props;
---

<!-- The site's only search box: a centered popup over a blurred mask (styles: `.search-panel*` in global.css).
     Opened by the topbar button, any `[data-search-open="<location>"]` trigger (the home page field),
     or `/` and ⌘K / Ctrl+K. The opener becomes the Umami `location` of the queries typed in it. -->
<button
  id="search-btn"
  type="button"
  class={`${buttonClass} border-0 bg-transparent`}
  title="搜尋文章（/）"
  aria-label="搜尋文章"
  aria-haspopup="dialog"
  aria-controls="search-panel"
  data-search-open="topbar"
  data-umami-event="click-search-topbar"
>
  <Search class="h-4 w-4" stroke-width={2} aria-hidden="true" />
</button>

<div id="search-panel" class="search-panel" role="dialog" aria-modal="true" aria-label="搜尋文章" hidden>
  <div class="search-panel-mask" aria-hidden="true"></div>
  <div class="search-panel-body">
    <SearchBox location="topbar" />
  </div>
</div>

<script>
  const panel = document.getElementById('search-panel') as HTMLDivElement;
  const body = panel.querySelector<HTMLElement>('.search-panel-body')!;
  const box = panel.querySelector<HTMLElement>('[data-search-box]')!;
  const input = panel.querySelector<HTMLInputElement>('[data-search-input]')!;
  let opener: HTMLElement | null = null;

  const isOpen = () => !panel.hidden;

  function open(location: string, trigger: HTMLElement | null) {
    if (isOpen()) return;
    opener = trigger;
    box.dataset.location = location;
    panel.hidden = false;
    document.querySelectorAll('[data-search-open]').forEach(el => el.setAttribute('aria-expanded', 'true'));
    input.focus();
    input.select();
  }

  // Query logging on close is handled by the box itself (outside pointerdown / Escape)
  function close({ restoreFocus = false } = {}) {
    if (!isOpen()) return;
    panel.hidden = true;
    document.querySelectorAll('[data-search-open]').forEach(el => el.setAttribute('aria-expanded', 'false'));
    if (restoreFocus) opener?.focus();
  }

  document.addEventListener('click', event => {
    const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-search-open]');
    if (!trigger) return;
    if (isOpen()) close();
    else open(trigger.dataset.searchOpen ?? 'unknown', trigger);
  });
  panel.addEventListener('search:escape', () => close({ restoreFocus: true }));
  // Tab past the last control would land on the page behind the mask: treat it as leaving the search
  panel.addEventListener('focusout', event => {
    const next = event.relatedTarget as Node | null;
    if (next && !body.contains(next)) close();
  });
  document.addEventListener('pointerdown', event => {
    const target = event.target as HTMLElement;
    if (isOpen() && !body.contains(target) && !target.closest('[data-search-open]')) close();
  });

  document.addEventListener('keydown', event => {
    const target = event.target as HTMLElement;
    const typing = target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName);
    const shortcut = ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k')
      || (event.key === '/' && !typing && !event.metaKey && !event.ctrlKey && !event.altKey);
    if (!shortcut) return;
    event.preventDefault();
    if (isOpen()) close({ restoreFocus: true });
    else open('shortcut', document.getElementById('search-btn'));
  });
</script>
