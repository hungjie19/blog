---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import AsciiOcean from '../components/AsciiOcean.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);
---

<BlogLayout metaTitle="Jasper Hung — Coworking with AI">
  <h1 class="sr-only">Jasper Hung</h1>
  <AsciiOcean />
  <!-- Phones (≤768px) don't load the ocean; panel styles only apply when it's there -->
  <div class="min-[769px]:rounded-[10px] min-[769px]:bg-bg/60 min-[769px]:px-6 min-[769px]:backdrop-blur-sm" data-ocean-solid>
    <a
      href="https://island.jasperhung.dev/"
      target="_blank"
      rel="noopener"
      class="group relative mt-6 mb-2 block overflow-hidden rounded-[10px] border border-border no-underline transition-[border-color,transform] duration-150 hover:-translate-y-0.5 hover:border-accent active:translate-y-0"
      data-umami-event="click-island-homepage"
    >
      <img
        src={`${base}images/home/island-banner.jpg`}
        alt="Island Blog：把部落格各系列做成漂浮在宇宙中的 3D 六角島群"
        class="block aspect-[3/1] w-full object-cover"
        width="1600"
        height="533"
      />
      <span class="absolute inset-x-0 bottom-0 flex items-end bg-gradient-to-t from-black/75 to-transparent px-4 pb-3 pt-10 text-white">
        <span class="text-sm font-semibold sm:text-base">Island Blog：用 3D 浮島逛所有系列 <span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:translate-x-0.5">↗</span></span>
      </span>
    </a>
    <div class="feed">
      {posts.map((post, i) => (
        <article class="feed-item" data-index={i}>
          <a href={`${base}posts/${post.id}/`} class="feed-link" data-umami-event="click-post-homepage" data-umami-event-destination={post.id}>
            <span class="feed-title">{post.data.title}</span>

            {post.data.cover ? (
              <div class="feed-body">
                <p class="feed-desc feed-desc--clamp">{post.data.description}</p>
                <img
                  class="feed-thumb"
                  src={`${base}images/posts/${post.id}/thumb.jpg`}
                  alt=""
                  width="480"
                  height="360"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ) : post.data.description && (
              <p class="feed-desc">{post.data.description}</p>
            )}
          </a>

          <div class="feed-meta">
            <time>{post.data.date.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '-')}</time>
            {post.data.tags.length > 0 && (
              <div class="feed-tags">
                {post.data.tags.map(tag => (
                  <a href={`${base}tags/${tag}/`} class="feed-tag">#{tag}</a>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</BlogLayout>

<style>
  .feed { display: flex; flex-direction: column; }

  .feed-item { padding: 24px 0; }

  .feed-link {
    display: block;
    text-decoration: none;
    color: var(--text);
  }

  /* 1. 標題永遠是入口 */
  .feed-title {
    display: block;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-bottom: 8px;
  }

  .feed-link:hover .feed-title { text-decoration: underline; }

  /* 2. description 緊貼標題，當判斷輔助 */
  .feed-desc {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.65;
    margin: 0 0 8px;
  }

  /* 有封面：desc 左、4:3 縮圖右，縮圖高度 = desc 行數 × 行高（桌面 3 行、手機 2 行） */
  .feed-body {
    --desc-lines: 3;
    --desc-line: calc(16px * 1.65);
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin: 0 0 8px;
  }

  .feed-body .feed-desc { flex: 1; min-width: 0; margin: 0; }

  .feed-desc--clamp {
    display: -webkit-box;
    -webkit-line-clamp: var(--desc-lines);
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .feed-thumb {
    flex-shrink: 0;
    height: calc(var(--desc-line) * var(--desc-lines));
    width: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--border);
    display: block;
  }

  /* 3. date / tags 是 metadata，放最後 */
  .feed-meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 12px;
    font-size: 14px;
  }

  time {
    font-size: 14px;
    color: var(--muted);
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  .feed-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
  }

  .feed-tag {
    color: var(--accent-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .feed-tag:hover { color: var(--accent); }

  @media (max-width: 640px) {
    .feed-body { --desc-lines: 2; gap: 12px; }

    .feed-desc {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

  }

  .feed-item:not(:last-child) {
    border-bottom: 1px solid var(--border);
  }

  .feed-item {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1), transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .feed-item.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const items = document.querySelectorAll('.feed-item');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const i = Number(el.dataset.index);
          setTimeout(() => el.classList.add('visible'), i * 80);
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.05 }
  );
  items.forEach(item => observer.observe(item));
</script>
