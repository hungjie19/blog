---
import { getCollection } from 'astro:content';
import { LayoutGrid, List } from '@lucide/astro';
import BlogLayout from '../layouts/BlogLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);
// macOS-style segmented control: surface track, the selected segment is raised
const viewButtonClass =
  'flex cursor-pointer items-center rounded-md border-0 bg-transparent px-2 py-1 text-muted transition-colors duration-150 hover:text-text aria-pressed:bg-raised aria-pressed:text-text aria-pressed:shadow-[0_1px_2px_rgb(0_0_0/0.12),0_0_0_0.5px_rgb(0_0_0/0.06)]';
---

<BlogLayout
  metaTitle="Jasper Hung — Coworking with AI"
  description="Jasper Hung 的部落格，記錄與 AI 協作的實戰經驗：Claude Code、Agent 工作流、Skill 設計、本地記憶，以及用 Astro、Cloudflare 架站與 SEO／AEO 的實測過程與踩坑筆記。"
>
  <!-- Feed view (list / card) must land before first paint: card view also widens the content column.
       Saved choice wins; otherwise phones default to card, wider screens to list. -->
  <script is:inline>
    (() => {
      let view = null;
      try { view = localStorage.getItem('feed-view'); } catch {}
      if (view !== 'list' && view !== 'card') {
        view = window.matchMedia('(max-width: 640px)').matches ? 'card' : 'list';
      }
      document.documentElement.dataset.feedView = view;
    })();
  </script>

  <h1 class="sr-only">Jasper Hung</h1>
  <div>
    <a
      href="https://island.jasperhung.dev/"
      target="_blank"
      rel="noopener"
      class="island-banner group relative mb-2 block overflow-hidden rounded-[10px] border border-border no-underline transition-[border-color,transform] duration-150 hover:-translate-y-0.5 hover:border-accent active:translate-y-0"
      data-umami-event="click-island-homepage"
    >
      <img
        src={`${base}images/home/island-banner.jpg`}
        alt="Island Blog：把部落格各系列做成漂浮在宇宙中的 3D 六角島群"
        class="block aspect-[3/1] w-full object-cover"
        width="1600"
        height="533"
      />
      <span class="absolute inset-x-0 bottom-0 flex items-end bg-gradient-to-t from-black/75 to-transparent px-4 pb-3 pt-10 text-white">
        <span class="text-sm font-semibold sm:text-base">Island Blog：用 3D 浮島逛所有系列 <span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:translate-x-0.5">↗</span></span>
      </span>
    </a>

    <div class="mt-4 flex justify-end">
      <div class="inline-flex gap-0.5 rounded-lg border border-border bg-surface p-0.5" role="group" aria-label="文章列表顯示方式">
      <button type="button" class={viewButtonClass} data-feed-view-btn="list" aria-pressed="false" title="列表" aria-label="列表顯示" data-umami-event="switch-feed-view-homepage" data-umami-event-view="list">
        <List size={16} />
      </button>
      <button type="button" class={viewButtonClass} data-feed-view-btn="card" aria-pressed="false" title="卡片" aria-label="卡片顯示" data-umami-event="switch-feed-view-homepage" data-umami-event-view="card">
        <LayoutGrid size={16} />
      </button>
      </div>
    </div>

    <!-- Card columns follow the content width like the Series page: 1 / 2 / 3 / 4 -->
    <div class="feed-container">
      <div class="feed">
        {posts.map((post) => (
          <article class:list={["feed-item", { "feed-item--cover": post.data.cover }]}>
            {post.data.cover && (
              <a
                href={`${base}posts/${post.id}/`}
                class="feed-cover"
                tabindex="-1"
                aria-hidden="true"
                data-umami-event="click-post-homepage"
                data-umami-event-destination={post.id}
                data-umami-event-position="cover"
              >
                <!-- list view: 4:3 thumb.jpg; card view swaps to the 1.91:1 og.jpg -->
                <img
                  class="feed-thumb"
                  src={`${base}images/posts/${post.id}/thumb.jpg`}
                  data-thumb={`${base}images/posts/${post.id}/thumb.jpg`}
                  data-og={`${base}images/posts/${post.id}/og.jpg`}
                  alt=""
                  width="480"
                  height="360"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            )}

            <div class="feed-main">
              <a href={`${base}posts/${post.id}/`} class="feed-link" data-umami-event="click-post-homepage" data-umami-event-destination={post.id}>
                <span class="feed-title">{post.data.title}</span>

                {post.data.description && (
                  <p class="feed-desc">{post.data.description}</p>
                )}
              </a>

              <div class="feed-meta">
                <time>{post.data.date.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '-')}</time>
                {post.data.tags.length > 0 && (
                  <div class="feed-tags">
                    {post.data.tags.map(tag => (
                      <a href={`${base}tags/${tag}/`} class="feed-tag">#{tag}</a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <!-- Runs right after the feed is parsed, before layout, so card view never fetches the thumbs first -->
  <script is:inline>
    if (document.documentElement.dataset.feedView === 'card') {
      document.querySelectorAll('.feed-thumb').forEach((img) => { img.src = img.dataset.og; });
    }
  </script>
</BlogLayout>

<style is:global>
  /* Card view uses the same wide column as the Series page */
  html[data-feed-view="card"] .content-wrapper { max-width: 1280px; }
</style>

<style>
  .feed-container { container-type: inline-size; }

  .feed { display: flex; flex-direction: column; }

  .feed-item { padding: 24px 0; }

  .feed-link {
    display: block;
    text-decoration: none;
    color: var(--text);
  }

  /* 1. 標題永遠是入口 */
  .feed-title {
    display: block;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-bottom: 8px;
  }

  .feed-link:hover .feed-title { text-decoration: underline; }

  /* 2. description 緊貼標題，當判斷輔助 */
  .feed-desc {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.65;
    margin: 0 0 8px;
  }

  .feed-cover { display: block; }

  .feed-thumb {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--border);
    /* placeholder while the lazy image loads */
    background: var(--surface);
  }

  /* 3. date / tags 是 metadata，放最後 */
  .feed-meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 12px;
    font-size: 14px;
  }

  time {
    font-size: 14px;
    color: var(--muted);
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  .feed-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    min-width: 0;
    line-height: 1.5;
    /* When a view caps max-height to one line, tags that wrap to line 2 are hidden whole, never cut mid-word */
    overflow: hidden;
  }

  .feed-tag {
    color: var(--accent-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .feed-tag:hover { color: var(--accent); }

  .feed-item {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1), transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .feed-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ───────── List view (default) ───────── */

  /* 有封面：GitHub Blog 式排法，4:3 縮圖在左，title / desc / meta 一欄在右 */
  :global(html:not([data-feed-view="card"])) .feed-item--cover {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    column-gap: 24px;
    align-items: start;
  }

  :global(html:not([data-feed-view="card"])) .feed-item:not(:last-child) {
    border-bottom: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    :global(html:not([data-feed-view="card"])) .feed-item--cover {
      grid-template-columns: 96px minmax(0, 1fr);
      column-gap: 14px;
    }

    /* 手機：desc 2 行、tags 收成一行，省縱向空間 */
    :global(html:not([data-feed-view="card"])) .feed-desc {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    :global(html:not([data-feed-view="card"])) .feed-meta { flex-wrap: nowrap; }
    :global(html:not([data-feed-view="card"])) .feed-tags { max-height: 1.5em; }
  }

  /* ───────── Card view：照 Series 頁的卡片 ───────── */

  :global(html[data-feed-view="card"]) .feed {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 20px;
    /* list items carry their own 24px top padding; cards don't, so keep the view toggle off the first card */
    margin-top: 16px;
  }

  @container (min-width: 36rem) {
    :global(html[data-feed-view="card"]) .feed { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @container (min-width: 56rem) {
    :global(html[data-feed-view="card"]) .feed { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @container (min-width: 72rem) {
    :global(html[data-feed-view="card"]) .feed { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  :global(html[data-feed-view="card"]) .feed-item {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
  }

  :global(html[data-feed-view="card"]) .feed-item:hover { border-color: var(--accent); }

  :global(html[data-feed-view="card"]) .feed-thumb {
    aspect-ratio: 1200 / 630;
    border: 0;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
  }

  :global(html[data-feed-view="card"]) .feed-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 16px;
  }

  :global(html[data-feed-view="card"]) .feed-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 1rem;
    line-height: 1.375;
  }

  :global(html[data-feed-view="card"]) .feed-desc {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 14px;
    margin: 0;
  }

  :global(html[data-feed-view="card"]) .feed-meta {
    margin-top: auto;
    padding-top: 16px;
    flex-wrap: nowrap;
    overflow: hidden;
  }

  :global(html[data-feed-view="card"]) .feed-tags { max-height: 1.5em; }

  /* Card view widens the column to 1280px; keep the Island banner at the list-view size (740px column minus padding) */
  :global(html[data-feed-view="card"]) .island-banner {
    max-width: calc(740px - 64px);
    margin-inline: auto;
  }
</style>

<script>
  const html = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-feed-view-btn]');
  const thumbs = document.querySelectorAll<HTMLImageElement>('.feed-thumb');

  function applyView(view: 'list' | 'card') {
    html.dataset.feedView = view;
    thumbs.forEach((img) => {
      const next = view === 'card' ? img.dataset.og : img.dataset.thumb;
      if (next && img.getAttribute('src') !== next) img.src = next;
    });
    buttons.forEach((btn) => btn.setAttribute('aria-pressed', String(btn.dataset.feedViewBtn === view)));
  }

  applyView(html.dataset.feedView === 'card' ? 'card' : 'list');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const view = btn.dataset.feedViewBtn === 'card' ? 'card' : 'list';
      try { localStorage.setItem('feed-view', view); } catch {}
      applyView(view);
    });
  });

  // Stagger only within the batch that enters together. Using the global index made item 50
  // wait 4s, leaving a blank block on phones where one big card fills the screen.
  const STAGGER_MS = 80;
  const items = document.querySelectorAll('.feed-item');
  const observer = new IntersectionObserver(
    (entries) => {
      let order = 0;
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          setTimeout(() => el.classList.add('visible'), order++ * STAGGER_MS);
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.05 }
  );
  items.forEach(item => observer.observe(item));
</script>
