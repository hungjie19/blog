---
import { getCollection, render } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import AuthorCard from "../../components/AuthorCard.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import KeyTakeaways from "../../components/KeyTakeaways.astro";
import { getSeries, seriesLabel, sortSeriesEntries } from "../../lib/series";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const byDate = [...posts].sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

  return posts.map((post) => {
    const toNav = (p: (typeof posts)[number] | undefined) =>
      p ? { slug: p.id, title: p.data.title } : null;

    const dateIndex = byDate.findIndex((p) => p.id === post.id);
    const prevPost = toNav(byDate[dateIndex - 1]);
    const nextPost = toNav(byDate[dateIndex + 1]);

    let seriesId = null;
    let seriesName = null;
    let seriesList = null;
    let seriesType = null;
    if (post.data.series) {
      const series = getSeries(post.data.series);
      seriesId = post.data.series;
      seriesName = series?.title ?? seriesLabel(post.data.series);
      seriesType = series?.type ?? "series";
      // 跟系列頁一致：最新的放最上面
      seriesList = sortSeriesEntries(
        posts.filter((p) => p.data.series === post.data.series),
      )
        .reverse()
        .map((p) => ({
          slug: p.id,
          title: p.data.title,
          current: p.id === post.id,
        }));
    }

    return {
      params: { slug: post.id },
      props: { post, seriesId, seriesName, seriesList, seriesType, prevPost, nextPost },
    };
  });
}

const { post, seriesId, seriesName, seriesList, seriesType, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const isSeriesCollection = seriesType === "collection";

const text = post.body ?? "";
const chineseChars = (text.match(/[一-鿿]/g) ?? []).length;
const englishWords = (text.match(/[a-zA-Z]+/g) ?? []).length;
const minutes = Math.max(1, Math.ceil(chineseChars / 400 + englishWords / 200));
const readingTime = `約 ${minutes} 分鐘`;
---

<BlogLayout
  title={post.data.title}
  activeSlug={post.id}
  description={post.data.description}
  date={post.data.date instanceof Date
    ? post.data.date.toISOString()
    : String(post.data.date ?? "")}
>
  <article>
    <div class="article-header">
      <h1 class="article-title">
        {post.data.title}
      </h1>
      <div class="article-meta">
        <span
          >{
            post.data.date.toLocaleDateString("zh-TW", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }</span
        >
        <span>{readingTime}</span>
        {
          post.data.tags.map((tag) => (
            <a href={`/tags/${tag}/`} class="meta-link" data-umami-event="click-tag-pill">
              #{tag}
            </a>
          ))
        }
      </div>
    </div>

    <div class="article-body">
      <Content components={{ KeyTakeaways }} />
    </div>
    {
      seriesList && (
        <aside class="series-box" aria-label="系列文章">
          <a href={`/series/${seriesId}/`} class="series-box-title" data-umami-event="click-series-overview-post">
            {isSeriesCollection ? `${seriesName}（共 ${seriesList.length} 篇）` : `${seriesName} 系列（共 ${seriesList.length} 篇）`}
            <span aria-hidden="true"> →</span>
          </a>
          {
            isSeriesCollection ? (
              <ul class="series-box-list series-box-list-collection">
                {seriesList.map((item) =>
                  item.current ? (
                    <li class="series-box-current">
                      {item.title}
                      <span class="series-box-badge">目前這篇</span>
                    </li>
                  ) : (
                    <li>
                      <a href={`/posts/${item.slug}/`} data-umami-event="click-series-nav">{item.title}</a>
                    </li>
                  ),
                )}
              </ul>
            ) : (
              <ol class:list={["series-box-list", seriesList.length >= 10 && "series-box-list-wide"]} reversed>
                {seriesList.map((item) =>
                  item.current ? (
                    <li class="series-box-current">
                      {item.title}
                      <span class="series-box-badge">目前這篇</span>
                    </li>
                  ) : (
                    <li>
                      <a href={`/posts/${item.slug}/`} data-umami-event="click-series-nav">{item.title}</a>
                    </li>
                  ),
                )}
              </ol>
            )
          }
        </aside>
      )
    }
    {
      (prevPost || nextPost) && (
        <nav class="post-nav" aria-label="文章導航">
          {prevPost ? (
            <a href={`/posts/${prevPost.slug}/`} class="post-nav-link" data-umami-event="click-prev-post">
              <span class="post-nav-label">← 上一篇</span>
              <span class="post-nav-title">{prevPost.title}</span>
            </a>
          ) : (
            <span class="post-nav-spacer" />
          )}
          {nextPost ? (
            <a
              href={`/posts/${nextPost.slug}/`}
              class="post-nav-link post-nav-next"
              data-umami-event="click-next-post"
            >
              <span class="post-nav-label">下一篇 →</span>
              <span class="post-nav-title">{nextPost.title}</span>
            </a>
          ) : (
            <span class="post-nav-spacer" />
          )}
        </nav>
      )
    }
    <AuthorCard />
  </article>
  <TableOfContents headings={headings} />
</BlogLayout>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import PhotoSwipeDynamicCaption from 'photoswipe-dynamic-caption-plugin';
  import 'photoswipe/style.css';
  import 'photoswipe-dynamic-caption-plugin/photoswipe-dynamic-caption-plugin.css';

  const gallery = document.querySelector('.article-body');
  if (gallery) {
    const images = gallery.querySelectorAll<HTMLImageElement>('img:not(a img)');

    for (const img of images) {
      const link = document.createElement('a');
      link.href = img.currentSrc || img.src;
      link.className = 'lightbox-trigger';
      link.dataset.pswpWidth = img.getAttribute('width') ?? '';
      link.dataset.pswpHeight = img.getAttribute('height') ?? '';

      const captionEl = img.closest('figure')?.querySelector('figcaption');
      if (captionEl) {
        const captionContent = document.createElement('div');
        captionContent.className = 'pswp-caption-content';
        captionContent.hidden = true;
        captionContent.textContent = captionEl.textContent ?? '';
        link.appendChild(captionContent);
      }

      img.replaceWith(link);
      link.appendChild(img);
    }

    const lightbox = new PhotoSwipeLightbox({
      gallery: '.article-body',
      children: 'a.lightbox-trigger',
      pswpModule: () => import('photoswipe'),
    });
    new PhotoSwipeDynamicCaption(lightbox, { type: 'below' });
    lightbox.init();
  }

  // Heading anchors: click a heading to copy its link and scroll it to the top
  const anchorHeadings = document.querySelectorAll<HTMLHeadingElement>(
    '.article-body :is(h2, h3)[id]:not(.key-takeaways *)',
  );
  const anchorIcon =
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">' +
    '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>' +
    '<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';
  let toastTimer: number | undefined;

  function showCopiedToast() {
    const toast =
      document.querySelector<HTMLDivElement>('.heading-anchor-toast') ??
      document.body.appendChild(
        Object.assign(document.createElement('div'), {
          className: 'heading-anchor-toast',
          role: 'status',
          textContent: '已複製段落連結',
        }),
      );
    toast.classList.add('is-visible');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 1600);
  }

  for (const heading of anchorHeadings) {
    const anchor = document.createElement('a');
    anchor.className = 'heading-anchor';
    anchor.href = `#${heading.id}`;
    anchor.setAttribute('aria-label', `複製「${heading.textContent?.trim() ?? ''}」段落連結`);
    anchor.innerHTML = anchorIcon;
    heading.prepend(anchor);
    heading.classList.add('has-anchor');

    heading.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      // Let inline links inside the heading navigate normally
      if (target.closest('a') && target.closest('a') !== anchor) return;
      // Don't hijack a text selection drag
      if (window.getSelection()?.toString()) return;
      event.preventDefault();

      const shareUrl = new URL(window.location.href);
      shareUrl.searchParams.set('utm_source', 'copy_link');
      shareUrl.searchParams.set('utm_medium', 'heading_anchor');
      shareUrl.hash = heading.id;
      navigator.clipboard?.writeText(shareUrl.toString()).then(showCopiedToast, () => {});

      history.replaceState(null, '', `#${heading.id}`);
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      heading.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });

      window.umami?.track('copy-heading-link', { heading: heading.id });
    });
  }
</script>

<style>
  .article-header {
    margin-bottom: 34px;
  }

  .article-title {
    font-size: 2.125rem;
    font-weight: 650;
    color: var(--heading);
    line-height: 1.25;
    letter-spacing: 0;
    text-wrap: pretty;
    margin: 0 0 14px;
  }

  .article-meta {
    display: flex;
    gap: 10px 12px;
    font-size: 14px;
    color: var(--muted);
    align-items: center;
    flex-wrap: wrap;
  }

  .article-meta a {
    font-size: inherit;
  }

  .article-body {
    color: var(--article-text);
    font-size: 18px;
    line-height: 1.8;
    font-family: inherit;
    /* 不用 text-wrap: pretty：Safari 把它實作成整段最佳化，
       中日韓文字每字皆可斷行，會讓整段行寬一起縮短、右側留下大片空白。
       標題仍保留 pretty（Safari 等同 balance，對短標題有益）。 */
    text-wrap: auto;
  }

  /* H1-H6 (body = 18px) */
  .article-body :global(h1) {
    font-size: 2rem;
    font-weight: 700;
    margin: 2.5rem 0 1rem;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--heading);
  }
  .article-body :global(h2) {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 2.25rem 0 0.75rem;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--heading);
  }
  .article-body :global(h3) {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 2rem 0 0.5rem;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--heading);
  }
  .article-body :global(h4) {
    font-size: 1.375rem;
    font-weight: 600;
    margin: 1.75rem 0 0.5rem;
    line-height: 1.4;
    color: var(--heading);
  }
  .article-body :global(h5) {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem;
    line-height: 1.4;
    color: var(--heading);
  }
  .article-body :global(h6) {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 1.25rem 0 0.5rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--heading);
  }

  .article-body :global(.has-anchor) {
    position: relative;
    cursor: pointer;
    scroll-margin-top: 12px;
  }
  .article-body :global(.heading-anchor) {
    display: none;
  }
  /* 手機版 #mobile-title-bar（32px fixed）會蓋住捲到頂的標題 */
  @media (max-width: 768px) {
    .article-body :global(.has-anchor) {
      scroll-margin-top: 44px;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .article-body :global(.heading-anchor) {
      position: absolute;
      top: 50%;
      right: 100%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      margin-right: 6px;
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--muted);
      opacity: 0;
      transform: translateY(-50%);
      transition: opacity 0.15s, color 0.15s;
    }
    .article-body :global(.heading-anchor svg) {
      width: 12px;
      height: 12px;
    }
    .article-body :global(.has-anchor:hover .heading-anchor),
    .article-body :global(.heading-anchor:focus-visible) {
      opacity: 1;
    }
    .article-body :global(.heading-anchor:hover) {
      color: var(--heading);
      text-decoration: none;
    }
  }

  :global(.heading-anchor-toast) {
    /* topbar（48px）正下方右側，點標題後視線在上方 */
    position: fixed;
    top: 52px;
    right: 4px;
    z-index: 60;
    padding: 8px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--heading);
    font-size: 14px;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity 0.2s, transform 0.2s;
  }
  :global(.heading-anchor-toast.is-visible) {
    opacity: 1;
    transform: translateY(0);
  }

  .article-body :global(p) {
    margin: 0 0 1.2rem;
  }
  .article-body :global(a) {
    color: var(--link);
    text-decoration: none;
    text-underline-offset: 3px;
  }
  .article-body :global(a:hover) {
    text-decoration: underline;
  }

  .article-body :global(strong) {
    font-weight: 600;
    color: var(--heading);
  }
  .article-body :global(em) {
    font-style: italic;
  }
  .article-body :global(del) {
    text-decoration: line-through;
    opacity: 0.9;
  }

  .article-body :global(code:not(pre code)) {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.95em;
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: 0.4rem;
    padding: 1px 0.25rem;
    color: var(--code-inline);
    white-space: pre-wrap;
    font-variant-ligatures: none;
  }

  .article-body :global(.expressive-code) {
    --ec-codeFg: var(--code-text) !important;
    --ec-gtrFg: var(--code-muted) !important;
    --ec-gtrHlFg: var(--code-text) !important;
    --ec-lineNumbers-fg: var(--code-muted) !important;
    --ec-lineNumbers-hlFg: var(--code-text) !important;
    margin: 1.25rem 0;
    font-size: 16px;
  }

  .article-body :global(.expressive-code pre[data-language="plaintext"] .ec-line span[style^="--"]) {
    --0: var(--code-text) !important;
    --1: var(--code-text) !important;
  }

  .article-body :global(blockquote) {
    position: relative;
    margin: 1.5rem 0;
    padding: 20px 20px 20px 48px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    font-style: italic;
    color: var(--article-text);
  }

  .article-body :global(blockquote)::before {
    content: "\201C";
    position: absolute;
    left: 14px;
    top: 10px;
    font-size: 2.5rem;
    line-height: 1;
    color: var(--accent);
    font-style: normal;
    font-family: Georgia, serif;
  }

  .article-body :global(blockquote p) {
    margin: 0;
  }

  .article-body :global(ul) {
    list-style-type: disc;
    margin: 0 0 1.25rem;
    padding-left: 1.35rem;
  }

  .article-body :global(ul ul) {
    list-style-type: circle;
    margin: 0.35rem 0;
  }
  .article-body :global(ul ul ul) {
    list-style-type: square;
  }

  .article-body :global(ol) {
    list-style-type: decimal;
    margin: 0 0 1.25rem;
    padding-left: 1.35rem;
  }

  .article-body :global(li) {
    margin-bottom: 0.45rem;
  }

  .article-body :global(li input[type="checkbox"]) {
    margin-right: 6px;
    accent-color: var(--text);
  }

  .article-body :global(.table-scroll) {
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 1.25rem 0;
  }

  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
  }

  .article-body :global(th) {
    text-align: left;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: normal;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
    padding: 6px 12px 6px 0;
    min-width: calc(2em + 12px);
    overflow-wrap: anywhere;
    word-break: keep-all;
  }

  .article-body :global(td) {
    border-bottom: 1px solid var(--border);
    padding: 8px 12px 8px 0;
    vertical-align: top;
    min-width: calc(2em + 12px);
    overflow-wrap: anywhere;
    word-break: keep-all;
  }

  .article-body :global(hr) {
    border: none;
    height: 1px;
    margin: 2rem 0;
    background: linear-gradient(
      to right,
      transparent,
      color-mix(in srgb, var(--muted) 40%, transparent) 20%,
      color-mix(in srgb, var(--muted) 40%, transparent) 80%,
      transparent
    );
  }

  .article-body :global(img) {
    max-width: 100%;
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  .article-body :global(a.lightbox-trigger) {
    display: inline-block;
    text-decoration: none;
    cursor: zoom-in;
  }

  .article-body :global(.image-figure) {
    margin: 0;
  }

  .article-body :global(.image-caption) {
    margin: -0.65rem 0 1.75rem;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: center;
  }

  .series-box {
    margin-top: 2.5rem;
    padding: 16px 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .series-box-title {
    display: inline-block;
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
    text-decoration: none;
  }

  .series-box-title:hover { color: var(--text); }

  .series-box-list {
    margin: 0;
    padding-left: 1.35rem;
    list-style-type: decimal;
    font-size: 15px;
    line-height: 1.5;
  }

  .series-box-list li {
    margin-bottom: 6px;
  }

  .series-box-list li::marker {
    font-variant-numeric: tabular-nums;
  }

  /* 兩位數編號（10 篇以上）要多留一格，marker 才不會超出標題左緣 */
  .series-box-list-wide {
    padding-left: 3.6ch;
  }

  .series-box-list li:last-child {
    margin-bottom: 0;
  }

  .series-box-list-collection {
    padding-left: 1.35rem;
    list-style-type: disc;
  }

  .series-box-list a {
    color: var(--heading);
    text-decoration: none;
  }

  .series-box-list a:hover {
    opacity: 0.7;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .series-box-current {
    color: var(--muted);
  }

  .series-box-badge {
    margin-left: 8px;
    font-size: 12px;
    color: var(--accent);
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 2.5rem;
  }

  .series-box + .post-nav {
    margin-top: 12px;
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
  }

  .post-nav-link:hover .post-nav-title {
    opacity: 0.7;
  }

  .post-nav-next {
    text-align: right;
  }

  .post-nav-label {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .post-nav-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--heading);
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-nav-spacer {
      display: none;
    }

    .post-nav-next {
      text-align: left;
    }
  }

  @media (max-width: 640px) {
    .article-header {
      margin-bottom: 32px;
    }

    .article-title {
      line-height: 1.22;
      margin-bottom: 16px;
    }

    .article-meta {
      font-size: 14px;
      line-height: 1.45;
    }

    .article-body {
      font-size: 19px;
      line-height: 1.9;
    }

    .article-body :global(h1) {
      font-size: 2rem;
      margin: 2.6rem 0 1rem;
    }

    .article-body :global(h2) {
      font-size: 1.75rem;
      margin: 2.5rem 0 0.85rem;
    }

    .article-body :global(h3) {
      font-size: 1.45rem;
      margin: 2.1rem 0 0.7rem;
    }

    .article-body :global(p) {
      margin-bottom: 1.3rem;
    }

    .article-body :global(ul),
    .article-body :global(ol) {
      margin-bottom: 1.35rem;
      padding-left: 1.25rem;
    }

    .article-body :global(li) {
      margin-bottom: 0.5rem;
      padding-left: 0.1rem;
    }

    .article-body :global(blockquote) {
      margin: 1.75rem 0;
      padding: 18px 18px 18px 42px;
    }

    .article-body :global(table) {
      font-size: 14px;
    }

    .article-body :global(.expressive-code) {
      font-size: 14px;
      margin: 1.5rem 0;
    }
  }
</style>
