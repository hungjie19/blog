---
import BlogLayout from '../layouts/BlogLayout.astro';
import BrandIcon from '../components/BrandIcon.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

// Newest first. `date` is YYYY-MM-DD, or YYYY-MM when only the month is known;
// multi-day challenges use the finish date.
type Scope = 'Internal' | 'Public' | 'Online';
type Challenge = { date: string; scope: Scope; title: string; href?: string };
const challenges: Challenge[] = [
  { date: '2026-11-10', scope: 'Public', title: 'TOOCON #47 簡報' },
  {
    date: '2026-10-14',
    scope: 'Online',
    title: 'iThome 鐵人賽 30 天完賽：《跟著 Claude Academy，重新認識 Claude》',
    href: `${base}series/ithome-2026-ironman/`,
  },
  { date: '2026-08-06', scope: 'Internal', title: '簡報〈Spokenly：訓練自己的語音聽寫助理〉' },
  { date: '2026-06-11', scope: 'Internal', title: '簡報〈Knowledge is Memory：Cross-Session Memory〉' },
  { date: '2026-06-11', scope: 'Internal', title: '簡報〈Session is Knowledge：Create Your Skill〉' },
  { date: '2026-05-08', scope: 'Internal', title: '簡報〈Task Breakdown：Claude Cowork × MCP × Azure DevOps〉' },
];

const challengesByYear = Object.entries(
  Object.groupBy(
    challenges.map((item) => {
      const [year, month, day] = item.date.split('-');
      return {
        ...item,
        year,
        label: day ? `${month}/${day}` : `${month} 月`,
      };
    }),
    (item) => item.year,
  ),
).sort(([a], [b]) => b.localeCompare(a));
---

<BlogLayout
  title="About"
  description="關於 Jasper Hung：軟體工程師，研究 Agent Workflow，把它套進日常與工作，也完成 iThome 鐵人賽 30 天《跟著 Claude Academy，重新認識 Claude》。這裡分享 AI 工具、軟體開發，以及各種實驗與踩坑心得。"
  canonicalPath="/about/"
>
  <div class="about-wrapper">
    <header class="about-header">
      <img
        src={`${base}author-avatar.png`}
        alt="Jasper Hung"
        class="about-avatar"
      />
      <div>
        <h1 class="about-name">Jasper Hung</h1>
        <p class="about-role">Coworking with AI</p>
      </div>
    </header>

    <div class="about-bio">
      <p>我是 Jasper，軟體工程師，研究 Agent Workflow，把它套進日常與工作。</p>
      <p>現在主力用 Orca 指揮 Agent，搭 Tailscale 隨時連回來；懶得打字就開 Spokenly 語音聽寫。Claude 跟 Codex 雙開、三個帳號一起上工，記憶交給 OpenMemory、Obsidian 和 LLM Wiki 撐著。</p>
      <p>AI 用多了，輸入太多、輸出太少，腦袋快塞爆，乾脆開了這個部落格把東西倒出來。</p>
      <p>寫文之後，也開始關心 SEO、AEO 和社群經營。</p>
      <p>這裡分享 AI 工具、Agent Workflow、軟體開發，以及各種實驗與踩坑心得。</p>
    </div>

    <div class="about-links">
      <a href="https://github.com/hungjie19" target="_blank" rel="noopener" data-umami-event="click-github-about"><BrandIcon name="github" />GitHub</a>
      <a href="https://www.threads.com/@jasper.hung.one" target="_blank" rel="noopener" data-umami-event="click-threads-about"><BrandIcon name="threads" />Threads</a>
    </div>

    <section aria-labelledby="challenges-title" class="mt-12 border-t border-border pt-8">
      <h2 id="challenges-title" class="m-0 mb-5 text-lg font-semibold text-text">挑戰</h2>
      {challengesByYear.map(([year, items]) => (
        <div class="mb-6 last:mb-0">
          <div class="mb-2 text-sm font-semibold text-muted">{year}</div>
          <ol class="m-0 list-none p-0">
            {items!.map((item) => (
              <li class="flex items-start gap-3 border-b border-border py-2.5 text-[15px] leading-relaxed last:border-b-0">
                <span class="w-12 shrink-0 text-sm tabular-nums text-muted leading-[1.75]">{item.label}</span>
                <span class="w-[4.5rem] shrink-0 pt-px">
                  <span class="block whitespace-nowrap rounded-full border border-border py-0.5 text-center text-xs text-muted">{item.scope}</span>
                </span>
                <span class="min-w-0 flex-1 text-text">
                  {item.href
                    ? <a href={item.href} class="text-accent no-underline hover:underline" data-umami-event="click-challenge-about">{item.title}</a>
                    : item.title}
                </span>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </section>
  </div>
</BlogLayout>

<style>
  .about-wrapper {
    max-width: 600px;
    padding-top: 16px;
  }

  .about-header {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-bottom: 36px;
  }

  .about-avatar {
    width: 120px;
    height: 120px;
    border-radius: 12px;
    object-fit: cover;
    border: 1px solid var(--border);
    flex-shrink: 0;
  }

  .about-name {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.12;
    color: var(--text);
    margin: 0 0 10px;
    letter-spacing: -0.02em;
  }

  .about-role {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--muted);
    letter-spacing: 0.01em;
    margin: 6px 0 0;
  }

  @media (max-width: 480px) {
    .about-header {
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 32px;
    }

    .about-avatar {
      width: 88px;
      height: 88px;
      border-radius: 10px;
    }

    .about-name {
      font-size: 1.6rem;
    }

    .about-role {
      font-size: 1rem;
    }
  }

  .about-bio {
    color: var(--text);
    font-size: 18px;
    line-height: 1.8;
  }

  .about-bio p {
    margin: 0 0 1rem;
  }

  .about-links {
    display: flex;
    gap: 16px;
    margin-top: 20px;
  }

  .about-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 480px) {
    .about-bio {
      font-size: 19px;
      line-height: 1.9;
    }
  }

  .about-links a:hover {
    text-decoration: underline;
  }
</style>
