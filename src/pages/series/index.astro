---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { seriesLists } from '../../lib/series';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const posts = await getCollection('blog');
const series = Object.entries(seriesLists).map(([id, item]) => ({
  id,
  ...item,
  postCount: posts.filter(post => post.data.series === id).length,
}));
---

<BlogLayout
  title="Series"
  description="把相關的 AI 工作流程、工具與實作紀錄整理成可循序閱讀的系列。"
  canonicalPath="/series/"
>
  <section aria-labelledby="series-title">
    <h1 id="series-title" class="m-0 text-3xl font-bold tracking-[-0.02em] text-text">Series</h1>
    <p class="mt-3 max-w-[38rem] text-base leading-relaxed text-muted">把相關的工作流程、工具與實作紀錄放在一起，從一個主題開始讀。</p>

    <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2">
      {series.map(item => (
        <a
          href={`${base}series/${item.id}/`}
          class="group overflow-hidden rounded-[10px] border border-border bg-bg no-underline transition-[border-color,transform] duration-150 hover:-translate-y-0.5 hover:border-accent active:translate-y-0"
          data-umami-event="click-series-index"
          data-umami-event-destination={item.id}
        >
          {item.cover && (
            <img
              src={`${base}${item.cover.slice(1)}`}
              alt=""
              class="aspect-[16/9] w-full border-b border-border object-cover"
              loading="lazy"
            />
          )}
          <div class="p-4">
            <h2 class="m-0 text-base font-semibold leading-snug tracking-[-0.01em] text-text group-hover:text-accent">{item.title}</h2>
            <p class="mb-0 mt-2 text-sm leading-relaxed text-muted">{item.description}</p>
            <p class="mb-0 mt-4 text-sm text-accent-muted">{item.postCount} 篇文章</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BlogLayout>
