---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getSeries, seriesLists, sortSeriesEntries } from '../../lib/series';

export function getStaticPaths() {
  return Object.keys(seriesLists).map(id => ({ params: { id } }));
}

const id = Astro.params.id!;
const series = getSeries(id);

if (!series) throw new Error(`Unknown series: ${id}`);

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const isCollection = series.type === 'collection';
// 最新的放最上面：series 與 collection 都倒序顯示
const posts = sortSeriesEntries((await getCollection('blog')).filter(post => post.data.series === id)).reverse();
const ListTag = isCollection ? 'ul' : 'ol';
---

<BlogLayout
  title={series.title}
  description={series.description}
  canonicalPath={`/series/${id}/`}
  ogImageUrl={series.cover ? `https://jasperhung.dev${series.cover}` : undefined}
>
  <article>
    <header>
      {series.cover && (
        <img
          src={`${base}${series.cover.slice(1)}`}
          alt={`${series.title} 系列封面`}
          class="aspect-[16/9] w-full rounded-[10px] border border-border object-cover"
        />
      )}
      <h1 class="mb-0 mt-6 text-3xl font-bold tracking-[-0.02em] text-text">{series.title}</h1>
      <p class="mb-0 mt-3 max-w-[38rem] text-base leading-relaxed text-muted">{series.description}</p>
      {series.website && (
        <a
          href={series.website}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex text-sm font-medium text-accent underline decoration-border underline-offset-4 hover:decoration-accent"
          aria-label={`開啟 ${series.title} 官方網站（新分頁）`}
          data-umami-event="click-series-website"
          data-umami-event-destination={id}
        >
          活動官網 ↗
        </a>
      )}
      <p class="mb-0 mt-5 text-sm text-accent-muted">{posts.length} 篇文章</p>
    </header>

    <section class="mt-8" aria-labelledby="article-list-title">
      <h2 id="article-list-title" class="sr-only">文章目錄</h2>
      <ListTag class:list={['m-0 list-none border-t border-border p-0', !isCollection && 'series-article-list']}>
        {posts.map((post, index) => (
          <li class="border-b border-border">
            <PostRow
              post={post}
              href={`${base}posts/${post.id}/`}
              number={isCollection ? undefined : String(posts.length - index).padStart(2, '0')}
              class="py-5"
              data-umami-event="click-series-post"
              data-umami-event-destination={post.id}
            >
              <h3 class="m-0 text-base font-semibold leading-snug tracking-[-0.01em] text-text group-hover:text-accent">{post.data.title}</h3>
              <p class="mb-0 mt-1 text-sm text-muted">
                {post.data.date.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
              {post.data.description && <p class="mb-0 mt-2 text-sm leading-relaxed text-muted max-sm:line-clamp-2">{post.data.description}</p>}
            </PostRow>
          </li>
        ))}
      </ListTag>
    </section>
  </article>
</BlogLayout>
