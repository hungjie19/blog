---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getTags } from '../../lib/tags';

const posts = await getCollection('blog');
const tags = getTags(posts);

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<BlogLayout
  title="Tags"
  canonicalPath="/tags/"
  ogImageUrl="/images/tags/og.jpg"
  description={`Jasper Hung 部落格的 ${tags.length} 個標籤，依文章數排序：${tags.slice(0, 6).map(t => t.label).join('、')} 等 AI 協作、Agent 工作流程與建站實作主題。`}
>
  <div>
    <div class="mb-8">
      <div class="mb-2 text-[13px] text-muted">
        <a href={base} class="text-muted no-underline hover:text-text">所有文章</a>
        <span class="mx-1.5">›</span>
        <span>標籤</span>
      </div>
      <h1 class="m-0 text-2xl font-bold tracking-[-0.01em]">Tags</h1>
      <p class="m-0 mt-2 text-[13px] text-muted">{tags.length} 個標籤</p>
    </div>

    <div class="tags-cloud">
      {tags.map(t => (
        <a href={`${base}tags/${t.label}/`} class="tag-pill" data-umami-event="click-tag-pill" data-umami-event-location="tags-index">
          <span class="tag-name">#{t.label}</span>
          {t.count > 1 && <span class="tag-count">{t.count}</span>}
        </a>
      ))}
    </div>
  </div>
</BlogLayout>
